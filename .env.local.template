# MongoDB 连接字符串
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/electricity?retryWrites=true&w=majority

# 服务器端口
PORT=3000

# 健康检查HTTP端口（0=随机端口，看门狗会自动发现）
HEALTH_PORT=0

# 使用直连IP（绕过DNS解析）
USE_DIRECT_IP=true

# API Token（用于iPad/手机端上报数据时的认证，不设置则不启用）
# API_TOKEN=your-secret-token

# 电表 ID
METER_ID=YOUR_METER_ID

# 电表名称
METER_NAME=YOUR_METER_NAME

# 日志级别
LOG_LEVEL=info

# ========== 告警通知配置 ==========

# Server酱微信推送（唯一通知渠道）
# 注册地址: https://sct.ftqq.com/
# 获取SendKey后填入
# SERVER_CHAN_KEY=your-send-key

# 告警级别: error | warn | info（默认: warn）
# ALERT_LEVEL=warn

# 电量告警配置
# 当剩余电量低于此值时发送告警通知（单位：kWh）
# BATTERY_ALERT_THRESHOLD=1
# 告警冷却时间（小时），避免频繁发送告警
# BATTERY_ALERT_COOLDOWN_HOURS=4
# 只对最近读数发送告警，避免批量补发旧数据时误通知（分钟）
# BATTERY_ALERT_MAX_DATA_AGE_MINUTES=30

# 报告数据质量配置
# 统计周期至少需要的采样条数；默认12条
# REPORT_MIN_DATA_POINTS=12
# 统计周期最后一条数据距离周期结束最多允许相差多少分钟；默认30分钟
# REPORT_MAX_DATA_AGE_MINUTES=30
# 期望采集间隔，用于计算报告中的数据完整率；默认10分钟
# REPORT_EXPECTED_INTERVAL_MINUTES=10
# 仪表盘地址；配置后周报、月报会显示“查看详情”
# DASHBOARD_URL=https://your-app.example.com
# 电价（元/度）；配置后月报才会展示预估电费
# ELECTRICITY_PRICE_PER_KWH=0.60

# ========== 布布 AI 用电助手（可选）==========
# 不配置时，实时用电、周期统计、对比、预测与提醒仍可使用；
# 配置后，原因、规律、比较、总结与建议类问题会交给兼容 OpenAI Chat Completions 的模型服务分析。
# AI_API_KEY=your-ai-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your-model-name
# AI_FALLBACK_MODEL=optional-fallback-model-name
# 低余额主动提醒阈值（kWh）
# ASSISTANT_LOW_BALANCE_KWH=10

# 云端后端地址（iPad爬虫上报目标，多个用逗号分隔）
# BACKEND_URL=https://your-app.up.railway.app/api/report
# BACKEND_URLS=https://railway.app/api/report,https://zeabur.app/api/report

# ========== 米家设备日用电量（推荐）==========
# 首次连接请在运行服务的电脑打开 /api/xiaomi/history-probe；程序不会保存小米账号密码。
# 云端会话使用 AES-256-GCM 加密后存入现有 MongoDB；最简单且不易配错的做法是保持下面密钥不设置，程序会从 MONGO_URI 派生密钥。
# 若设置独立密钥，本地首次连接和 Railway 必须使用完全相同的值，否则 Railway 无法解密会话。
# XIAOMI_CLOUD_ENCRYPTION_KEY=replace-with-a-long-random-secret
# 默认每 15 分钟同步，只读取日用电量，不读取或展示实时功率。
# XIAOMI_ENERGY_SYNC_CRON=*/15 * * * *
